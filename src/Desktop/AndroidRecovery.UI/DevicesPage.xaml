<Page
    x:Class="AndroidRecovery.UI.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:AndroidRecovery.UI"
    xmlns:models="using:AndroidRecovery.Models">
    <ScrollViewer Background="{StaticResource PageBackgroundBrush}">
        <StackPanel Padding="32" Spacing="20" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:PageHeader Title="Connected Devices" Subtitle="Choose a device connected to this PC. USB detection does not mean ADB is authorized." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing IsActive="{Binding IsBusy}" Width="18" Height="18" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Refresh connected devices" />
                </StackPanel>
            </Grid>

            <Border Visibility="{Binding IsAdbUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Important" Foreground="{StaticResource WarningBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="ADB is not available" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Expander Header="Technical details" IsExpanded="False">
                            <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding DeviceCountLabel}" Foreground="{StaticResource TextMutedBrush}" />

            <Grid ColumnSpacing="20" MinHeight="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="360" />
                    <ColumnDefinition Width="1.4*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding HasDevices, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Detected Android devices">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AndroidDevice">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource SurfaceMutedBrush}">
                                            <SymbolIcon Symbol="Phone" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind AdbStateLabel}" Foreground="{x:Bind AdbState, Converter={StaticResource AdbStateToBrushConverter}}" FontSize="12" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind IdentitySummary}" Style="{StaticResource SecondaryTextBlockStyle}" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsDeviceListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <SymbolIcon Symbol="Phone" Foreground="{StaticResource TextMutedBrush}" Width="36" Height="36" HorizontalAlignment="Center" />
                            <TextBlock Text="No Android devices detected" Style="{StaticResource SectionTitleTextBlockStyle}" TextAlignment="Center" />
                            <TextBlock Text="Connect your phone using USB and enable USB debugging. Accept the authorization prompt on the phone when it appears." Style="{StaticResource SecondaryTextBlockStyle}" TextAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="Refresh devices" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedDeviceName}" Style="{StaticResource SectionTitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedDeviceIdentity}" Style="{StaticResource SecondaryTextBlockStyle}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Manufacturer" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedManufacturer}" />
                            <TextBlock Grid.Row="1" Text="Model" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedModel}" />
                            <TextBlock Grid.Row="2" Text="Product" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProduct}" />
                            <TextBlock Grid.Row="3" Text="Android version" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAndroidVersion}" />
                            <TextBlock Grid.Row="4" Text="API level" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedApiLevel}" />
                            <TextBlock Grid.Row="5" Text="ADB authorization" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedAuthorizationState}" />
                        </Grid>
                        <Border Visibility="{Binding SelectedDeviceNeedsAuthorization, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource WarningBackgroundBrush}" CornerRadius="6" Padding="12">
                            <TextBlock Text="Unlock your phone and accept the USB debugging prompt to authorize ADB access." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="ADB can read basic device properties after authorization. Access to private app data is restricted by Android." Style="{StaticResource SecondaryTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="View device details" Click="OnViewDetailsClick" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Continue" Click="OnContinueClick" IsEnabled="{Binding IsSelectedDeviceAuthorized}"
                                    Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Continue with selected authorized device" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsDeviceListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Device details" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="Select a detected device to inspect its connection and Android version." Style="{StaticResource SecondaryTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>