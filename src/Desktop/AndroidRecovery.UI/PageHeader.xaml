<UserControl
    x:Class="AndroidRecovery.UI.PageHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextBlockStyle}" />
    </StackPanel>
</UserControl>