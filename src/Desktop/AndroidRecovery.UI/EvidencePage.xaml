<Page
    x:Class="AndroidRecovery.UI.EvidencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:AndroidRecovery.UI"
    xmlns:recovery="using:AndroidRecovery.Recovery">
    <ScrollViewer Background="{StaticResource PageBackgroundBrush}">
        <StackPanel Padding="32" Spacing="20" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:PageHeader Title="Evidence" Subtitle="Inspect and verify read-only Android acquisition packages." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing IsActive="{Binding IsBusy}" Width="18" Height="18" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextBlockStyle}" />

            <Grid ColumnSpacing="20" MinHeight="380">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="360" /><ColumnDefinition Width="1.4*" MinWidth="360" /></Grid.ColumnDefinitions>
                <Grid>
                    <ListView ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding HasPackages, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Evidence packages">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="recovery:EvidencePackageSummary">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DeviceModel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind VerificationLabel}" Foreground="{StaticResource InfoBrush}" FontSize="12" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind DeviceManufacturer}" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind AcquiredUtc}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind AcquisitionMethod}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{x:Bind FileCount}" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind BytesAcquired}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <SymbolIcon Symbol="Folder" Width="40" Height="40" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No evidence packages" Style="{StaticResource SectionTitleTextBlockStyle}" TextAlignment="Center" />
                            <TextBlock Text="Completed acquisitions with real evidence files will appear here. No sample packages are shown." Style="{StaticResource SecondaryTextBlockStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Visibility="{Binding HasSelectedPackage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding SelectedDeviceName}" Style="{StaticResource SectionTitleTextBlockStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Acquired" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedAcquiredLabel}" />
                            <TextBlock Grid.Row="1" Text="Method" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMethodLabel}" />
                            <TextBlock Grid.Row="2" Text="Files" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPackage.FileCount}" />
                            <TextBlock Grid.Row="3" Text="Data" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSizeLabel}" />
                            <TextBlock Grid.Row="4" Text="Integrity" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVerificationLabel}" />
                            <TextBlock Grid.Row="5" Text="Status" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPackage.Status}" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedPackage.PackagePath}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Content="Analyze" Command="{Binding AnalyzeSelectedCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Verify" Command="{Binding VerifySelectedCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Open" Command="{Binding OpenSelectedCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>