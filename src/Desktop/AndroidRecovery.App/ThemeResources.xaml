<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="NavigationColor">#172A38</Color>
    <Color x:Key="NavigationHoverColor">#243B4B</Color>
    <Color x:Key="NavigationTextColor">#C4D0D8</Color>
    <Color x:Key="NavigationMutedColor">#AFC0CC</Color>
    <Color x:Key="NavigationBorderColor">#33495A</Color>
    <Color x:Key="BrandPrimaryColor">#1769AA</Color>
    <Color x:Key="BrandHoverColor">#0E568F</Color>
    <Color x:Key="PageBackgroundColor">#F3F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#EAF0F4</Color>
    <Color x:Key="TextPrimaryColor">#18252E</Color>
    <Color x:Key="TextSecondaryColor">#53636E</Color>
    <Color x:Key="TextMutedColor">#72818B</Color>
    <Color x:Key="BorderColor">#D8E0E5</Color>
    <Color x:Key="SuccessColor">#28734C</Color>
    <Color x:Key="SuccessBackgroundColor">#E6F3EA</Color>
    <Color x:Key="WarningColor">#8B5A0A</Color>
    <Color x:Key="WarningBackgroundColor">#FFF3D9</Color>
    <Color x:Key="ErrorColor">#A23A36</Color>
    <Color x:Key="ErrorBackgroundColor">#FCEBE9</Color>
    <Color x:Key="InfoColor">#285F83</Color>
    <Color x:Key="InfoBackgroundColor">#E8F2F8</Color>

    <SolidColorBrush x:Key="NavigationBrush" Color="{StaticResource NavigationColor}" />
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="{StaticResource NavigationHoverColor}" />
    <SolidColorBrush x:Key="NavigationTextBrush" Color="{StaticResource NavigationTextColor}" />
    <SolidColorBrush x:Key="NavigationMutedBrush" Color="{StaticResource NavigationMutedColor}" />
    <SolidColorBrush x:Key="NavigationBorderBrush" Color="{StaticResource NavigationBorderColor}" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackgroundColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoBackgroundColor}" />

    <x:Double x:Key="PagePadding">32</x:Double>
    <x:Double x:Key="SectionSpacing">24</x:Double>
    <x:Double x:Key="ControlSpacing">12</x:Double>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
</ResourceDictionary>