<Application
    x:Class="AndroidRecovery.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:AndroidRecovery.UI"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:AdbStateToBrushConverter x:Key="AdbStateToBrushConverter" />
            <ui:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <ui:SelectionToBrushConverter x:Key="SelectionToBrushConverter" />
            <ui:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>